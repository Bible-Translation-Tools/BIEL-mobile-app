<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <application>
    <!--
      Keeps the app process running (and its JavaScript download queue) while the user
      switches to another app. Android freezes cached background apps; a foreground
      service marks the app as in use for as long as a download runs.
    -->
    <service
      android:name=".DownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync"
      android:stopWithTask="true" />
  </application>
</manifest>
